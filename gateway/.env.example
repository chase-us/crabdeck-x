# Copy to .env and load it (e.g. `node --env-file=.env server.js` on Node 20+,
# or `export $(cat .env | xargs)` before `node server.js`).

# Bind address. Must be 0.0.0.0 (not 127.0.0.1) so Cloudflare / a reverse
# proxy can reach this process. HTTP 521 means the origin was not listening
# on a network interface the edge can dial.
HOST=0.0.0.0

# Port the gateway listens on.
PORT=8765

# Optional extra HTTP listeners for the public origin (Cloudflare :80/:443).
# Requires privilege for ports < 1024. Prefer docker compose / Caddy if you
# cannot bind these directly.
# ORIGIN_PORT=80,443

# REQUIRED before exposing this on a public domain (hermes-claw.ai).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every agent (hermes_agent.py, openclaw_agent.py) and the UI must be given the same value.
GATEWAY_TOKEN=

# Comma-separated list of origins allowed to open a browser WebSocket connection.
# Only enforced for connections that send an Origin header (i.e. browsers, not
# the Python agent processes).
ALLOWED_ORIGINS=http://localhost:5173

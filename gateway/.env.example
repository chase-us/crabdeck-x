# Copy to .env and load it (e.g. `node --env-file=.env server.js` on Node 20+,
# or `export $(cat .env | xargs)` before `node server.js`).

# Port the gateway listens on.
PORT=8765

# REQUIRED before exposing this on a public domain (hermes-claw.ai).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every agent (hermes_agent.py, openclaw_agent.py) and the UI must be given the same value.
GATEWAY_TOKEN=

# Comma-separated list of origins allowed to open a browser WebSocket connection.
# Only enforced for connections that send an Origin header (i.e. browsers, not
# the Python agent processes).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shell Cracked vault — heartbeats are forwarded here from HEARTBEAT frames, and
# swarm sessions retrieve (RAG) / write back memory through it. All fail-open.
VAULT_URL=http://localhost:7070
VAULT_TOKEN=

# Swarm mesh (artifacts/SWARM_MESH_PROTOCOL.md)
# Vault hits retrieved per swarm and attached to every round as RAG context.
SWARM_RAG_HITS=5
# Drop hits below this cosine score. Default embeddings are hash similarity, so
# leave at 0 unless VAULT_VECTOR_BACKEND uses semantic embeddings (then ~0.82).
SWARM_RAG_MIN_SCORE=0
# A round closes without silent peers after this long.
SWARM_ROUND_TIMEOUT_MS=45000

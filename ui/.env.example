# Copy to .env.local (Vite auto-loads this; the installer writes it for you).
# Anything prefixed VITE_ is exposed to client-side code via import.meta.env —
# do not put secrets here that you wouldn't want visible in browser devtools.
# GATEWAY_TOKEN is the one exception we accept: it's a shared bus token, not a
# user credential, and the gateway itself decides what each role may do.

VITE_GATEWAY_WS=ws://localhost:8765
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_ORCHESTRATOR=http://localhost:8000
VITE_GATEWAY_TOKEN=

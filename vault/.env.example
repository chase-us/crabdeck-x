PORT=7070
VAULT_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VAULT_DATA_DIR=./data
# sqlite (default, no extra deps) or chroma (requires: pip install chromadb)
VAULT_VECTOR_BACKEND=sqlite
# Embedding space for retrieval:
#   hash    (default) offline lexical vectors — real ranking, no deps
#   ollama  semantic vectors via OLLAMA_URL, falls back to hash when down
#   blake2  legacy v2.2 whole-string digest — not semantic, kept for old data
VAULT_EMBEDDER=hash
# Model used when VAULT_EMBEDDER=ollama
VAULT_EMBED_MODEL=nomic-embed-text

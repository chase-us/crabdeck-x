# Used by hermes_agent.py, openclaw_agent.py, and scribe_agent.py.
GATEWAY_URL=ws://localhost:8765
GATEWAY_TOKEN=
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=llama3

# Shell Cracked memory vault (heartbeats + vector history + RAG). Fail-open if down.
VAULT_URL=http://localhost:7070
VAULT_TOKEN=

# Swarm mesh
# Max concurrent contracts a peer will bid for before declining new CFPs.
MESH_MAX_LOAD=4
# Set to 0 to answer UI prompts without retrieving swarm memory first (Hermes).
RAG_ON_PROMPT=1
# Retrieval budget: passages kept (k) out of candidates scanned (n), and timeout.
RAG_TOP_K=4
RAG_CANDIDATES=12
RAG_TIMEOUT=3.0

# OpenClaw-specific:
OPENCLAW_HTTP=http://localhost:3131
# Leave at 0 unless you specifically need OpenClaw to run shell commands.
# Read the security note at the top of openclaw_agent.py before setting this to 1.
ENABLE_SHELL_EXEC=0
SHELL_ALLOWLIST=

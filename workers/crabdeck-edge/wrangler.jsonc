{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crabdeck-edge",
  "main": "src/index.ts",
  // Workers best practices (2026-09-10): keep compatibility_date current.
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Non-secret config only. Put EDGE_TOKEN in .dev.vars (local) or
  // `npx wrangler secret put EDGE_TOKEN` (remote). Never commit secrets.
  "vars": {
    "ORIGIN_URL": "http://127.0.0.1:8765",
    "VAULT_ORIGIN_URL": "http://127.0.0.1:7070",
    "ORCHESTRATOR_ORIGIN_URL": "http://127.0.0.1:8000",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://hermesclaw.ai"
  },
  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      // Unique per-account namespace id (stringified integer).
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
  // After this Worker is the orange-cloud origin (not a VPS), attach:
  // "routes": [{ "pattern": "hermesclaw.ai", "custom_domain": true }]
  // Custom domains make the Worker the origin, so Cloudflare probes this
  // process instead of a down VPS (HTTP 521).
}
